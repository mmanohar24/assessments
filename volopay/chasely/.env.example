# Copy this file to .env.local and fill it in. .env files are ignored by git.

# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret. Server only. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# The app's public address, with no slash at the end.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reminder emails, sent through Gmail SMTP. Server only.
# GMAIL_APP_PASSWORD is a Google app password (Google Account > Security > App passwords),
# not your normal password. Secret.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional. If set, every reminder goes to this address instead of the client's.
DEMO_EMAIL_OVERRIDE=
